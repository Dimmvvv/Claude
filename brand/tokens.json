{
  "_note": "Значения сняты с JPEG-макетов (погрешность ±2–3 в канале, прозрачности примерно). Заменить на точные из Figma.",
  "canvas": { "long": { "w": 3840, "h": 2160, "fps": 30 } },

  "color": {
    "beige":  { "hex": "#F8F4E9", "role": "базовый фон" },
    "green":  { "hex": "#0C3724", "role": "фон перебивок/анимаций" },
    "blue":   { "hex": "#101535", "role": "фон перебивок/анимаций" },
    "red":    { "hex": "#421A1A", "role": "фон перебивок/анимаций" },
    "brown":  { "hex": "#311C0B", "role": "фон перебивок/анимаций" },
    "yellow": { "hex": "#FCCD03", "role": "выделение" }
  },

  "background": {
    "base": "beige",
    "accent": ["green", "blue", "red", "brown"],
    "grid": {
      "step": 410, "origin_x": 278, "origin_y": 260, "line_width": 2,
      "line_on_dark":  { "color": "#FFFFFF", "opacity": 0.28 },
      "line_on_light": { "color": "#000000", "opacity": 0.32 }
    }
  },

  "pill": {
    "_note": "Плашка: название сериала или источник. Левый край на 1-й вертикали сетки, низ на 1-й горизонтали.",
    "x": 278, "y": 150, "h": 110, "radius": 55, "padding_x": 48,
    "stroke": { "width": 2, "on_dark": "#FFFFFF@0.35", "on_light": "#000000@0.35" },
    "text":   { "font": "body", "size": 64, "on_dark": "#FFFFFF@0.5", "on_light": "#000000@0.55" }
  },

  "font": {
    "display":        { "family": "CD Ovuer",           "role": "акцентная антиква: заголовки, выделения" },
    "display_pair":   { "family": "Gilroy Medium Italic", "role": "пара к CD Ovuer для выделений" },
    "body":           { "family": "Gilroy Regular",      "role": "базовый текст" },
    "_files": "brand/fonts/ (НЕ в git — лицензия): CDOvuer.*, Gilroy-Regular.*, Gilroy-MediumItalic.*"
  },

  "text_on_dark":  { "primary": "beige" },
  "text_on_light": { "primary": "#1A1A1A" },

  "highlight": {
    "color": "yellow", "opacity": 0.4,
    "on_light": "маркер под тёмным текстом (multiply), текст остаётся тёмным",
    "on_dark":  "плашка = жёлтый 40% поверх фона; текст на ней светло-жёлтый (~#FAE391)"
  }
}
